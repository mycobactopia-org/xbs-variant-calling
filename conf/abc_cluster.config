/*
 * abc_cluster.config — run xbs-variant-calling on the abc-cluster platform
 *                      via the nf-nomad executor (HashiCorp Nomad backend).
 *
 *   abc pipeline run https://github.com/mycobactopia-org/xbs-variant-calling \
 *     --revision <sha> --profile abc_cluster,test --param outdir=s3://...
 *
 * Adapted from MAGMA's conf/abc_cluster.config. nf-nomad runs each process
 * INSIDE its container, so we do NOT set docker.enabled here (avoids double-
 * wrapping). abc pipeline run injects executor / workDir / nomad{} / aws{} on
 * top of this.
 *
 * Container choices mirror MAGMA's for byte-identical command output across the
 * shared module set:
 *   - GATK4 / BWA / samtools / picard / bcftools → MAGMA's two bundled containers
 *     (magma-container-1 for GATK4 pipeline tools, magma-container-2 for the
 *     BWA / samtools / bcftools tier).
 */

params {
    // S3 outdir cannot be symlinked; publish by copy.
    publish_dir_mode = 'copy'
}

process {

    // ── Per-process container images (mirror MAGMA's abc_cluster.config) ─────
    withName: 'GATK4.*' {
        container = 'ghcr.io/torch-consortium/magma/magma-container-1:2.0.0'
    }
    withName: 'BWA.*|SAMTOOLS.*|PICARD.*|BCFTOOLS.*' {
        container = 'ghcr.io/torch-consortium/magma/magma-container-2:1.1.1'
    }

    // ── Resource parity with torch-magma's abc-cluster runs ──────────────────
    // MAGMA default was 4 CPU / 4 GB; cap nf-core labels to that so emitted
    // commands (thread counts, GATK -Xmx) match the MAGMA reference.
    withLabel: process_single { cpus = 1; memory = { 4.GB * task.attempt } }
    withLabel: process_low    { cpus = 4; memory = { 4.GB * task.attempt } }
    withLabel: process_medium { cpus = 4; memory = { 4.GB * task.attempt } }
    withLabel: process_high   { cpus = 4; memory = { 4.GB * task.attempt } }

    // ── Retry budget for transient Nomad placement / pull failures ────────────
    errorStrategy = { task.attempt < 3 ? 'retry' : 'ignore' }
    maxRetries    = 3
}

executor {
    queueSize = 8
}

// ── Distributed workdir over S3 via nf-nomad-s5cmd ─────────────────────────
// Turns on the s5cmd-backed workdir provider registered by the nf-nomad-s5cmd
// plugin (declared in the top-level `plugins {}` block). With workDir.enabled
// = true, .command.* + input files are shipped through S3 between the head
// alloc and each worker alloc — so head + workers no longer need to share a
// local `nf-work` host volume. That means workers can land on the `compute`
// pool (nomad01/02/03) while the head runs on `platform` (aither), giving
// real cross-node parallelism instead of the single-host pinning workaround.
//
// Endpoint / access-key / secret-key / bucket are injected by
// abc pipeline run's HCL layer at submission time (Nomad Variables in the
// target namespace). Users only need to pass `--work-dir s3://<bucket>/<prefix>`
// to `abc pipeline run` to opt in.
//
// Reference: abc-universe/design/decided/nf-s5cmd-distributed-workdir.md
s5cmd {
    workDir {
        enabled = true
    }
}
