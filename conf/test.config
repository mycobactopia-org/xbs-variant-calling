/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal MTB test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    3 M. tuberculosis H37Rv samples from EXIT-RIF (PRJNA1026351). Same
    dataset MAGMA uses for its `test` profile, so cross-checking against
    MAGMA's v0.3.0 outputs is straightforward.

    Use as:
        nextflow run mycobactopia-org/xbs-variant-calling \
            -profile test,<docker|singularity|conda> \
            --outdir results/
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus:   4,
        memory: '15.GB',
        time:   '2.h',
    ]
}

params {
    config_profile_name        = 'MTB test profile'
    config_profile_description = '3 EXIT-RIF (PRJNA1026351) M. tuberculosis H37Rv samples — matches MAGMA test profile'

    // ── Input samplesheet ──────────────────────────────────────────────────────
    input               = "${projectDir}/assets/samplesheet_test.csv"

    // ── Reference: bundled H37Rv ───────────────────────────────────────────────
    reference_dir       = "${projectDir}/resources/genome"
    reference_basename  = 'NC-000962-3-H37Rv'

    // ── VQSR: SNP truth set = Coll2018 (bundled). INDEL VQSR skipped: no
    //         curated INDEL truth set for MTB exists in MAGMA either.
    snp_truth_vcf       = "${projectDir}/resources/truth/Coll2018.UVPapproved.rRNAexcluded.vcf.gz"
    snp_truth_vcf_tbi   = "${params.snp_truth_vcf}.tbi"
    skip_indel_vqsr     = true

    // ── Small-N VQSR settings ──────────────────────────────────────────────────
    // 3 samples is far below Goig 2022's recommended 12+. Knock max-gaussians
    // down to 1 to give VariantRecalibrator a fighting chance to converge.
    vqsr_max_gaussians_snp     = 1

    // ── BQSR: skip (paper-true; matches MAGMA test profile) ────────────────────
    skip_bqsr           = true

    // ── MTB-specific Ti/Tv (Goig 2022 default) ─────────────────────────────────
    target_titv         = 1.85

    joint_name          = 'test_cohort'
}
