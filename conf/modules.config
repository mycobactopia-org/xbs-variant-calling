/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module ext.args / ext.prefix reproducing Heupink 2021 (XBS) flags
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Source of truth: TORCH-Consortium/XBS-variant-calling-core bash scripts
    + supplementary methods in PMC8743552 (Heupink et al. 2021, Microbial Genomics).
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ============================================================
    // Per-sample stages 1–7
    // ============================================================

    withName: 'BWA_MEM' {
        // -M: mark shorter split hits as secondary (Picard compatibility)
        // -K: process INPUT in chunks of size B (deterministic output regardless of -t)
        // -R: read-group header — REQUIRED by GATK HaplotypeCaller when
        //     --emit-ref-confidence GVCF is set (GATK errors otherwise with
        //     "Can only be used in single sample mode currently"). Built from
        //     samplesheet columns (see assets/schema_input.json):
        //         ID = <flowcell>.<lane>.<index_sequence>  (Illumina convention)
        //         PL = ILLUMINA (hard-coded — the pipeline targets short reads)
        //         LB = <sample>.<library>
        //         SM = <sample>       (this is what GATK keys off — 1 SM per BAM)
        //     Sensible fallbacks when the samplesheet omits the optional cols
        //     so a minimal (study,sample,library,r1,r2) samplesheet still works.
        //     Note the literal `\\t` in the Groovy string ⇒ bash keeps `\t`
        //     verbatim ⇒ bwa's parser interprets it as tab (bwa's `-R` docs
        //     document this convention).
        // bwa_extra_args is a hook for MAGMA's `-k 100` and similar consumer tuning.
        ext.args  = {
            def rg_id = "${meta.flowcell ?: 'UNNAMED'}.${meta.lane ?: 1}.${meta.index_sequence ?: 'NNNNNNNN'}"
            def rg_sm = "${meta.sample}"
            def rg_lb = "${meta.sample}.${meta.library}"
            def rg    = "@RG\\tID:${rg_id}\\tPL:ILLUMINA\\tLB:${rg_lb}\\tSM:${rg_sm}"
            "-M -K 100000000 -R \"${rg}\" ${params.bwa_extra_args ?: ''}"
        }
        ext.args2 = { "-@ ${task.cpus - 1} -O BAM" }                    // samtools sort piped after bwa
        ext.prefix = { "${meta.id}.sorted_reads" }
    }

    withName: 'SAMTOOLS_INDEX_LIB' {
        ext.prefix = { "${meta.id}.sorted_reads" }
    }

    withName: 'SAMTOOLS_MERGE' {
        // -f overwrite (mirrors XBS-core bash; without it single-library samples fail).
        ext.args   = '-f'
        ext.prefix = { "${meta.id}.merged" }
    }

    withName: 'GATK4_MARKDUPLICATES' {
        // ext.prefix is used verbatim as the BAM filename, so include the extension.
        ext.prefix = { "${meta.id}.markdup.bam" }
    }

    withName: 'SAMTOOLS_INDEX_MARKDUP' {
        ext.prefix = { "${meta.id}.markdup" }
    }

    withName: 'GATK4_BASERECALIBRATOR' {
        ext.prefix = { "${meta.id}.recal" }
    }

    withName: 'GATK4_APPLYBQSR' {
        ext.suffix = 'bam'                              // force BAM output (default is CRAM)
        ext.prefix = { "${meta.id}.recal" }
    }

    withName: 'SAMTOOLS_INDEX_RECAL' {
        ext.prefix = { "${meta.id}.recal" }
    }

    withName: 'SAMTOOLS_STATS' {
        // XBS-core bash filter flags verbatim
        ext.args   = '-F DUP,SUPPLEMENTARY,SECONDARY,UNMAP,QCFAIL'
        ext.prefix = { "${meta.id}.SamtoolStats" }
    }

    withName: 'SAMTOOLS_FLAGSTAT' {
        ext.prefix = { "${meta.id}.FlagStat" }
    }

    withName: 'PICARD_COLLECTWGSMETRICS' {
        // XBS-core flags verbatim
        ext.args   = '--READ_LENGTH 0 --COVERAGE_CAP 10000 --COUNT_UNPAIRED'
        ext.prefix = { "${meta.id}.WgsMetrics" }
    }

    withName: 'GATK4_HAPLOTYPECALLER' {
        // Heupink 2021: haploid ploidy + ERC GVCF + AS annotations + MQ0 filter
        ext.args   = {
            [
                "-ploidy ${params.sample_ploidy}",
                '-ERC GVCF',
                '-G StandardAnnotation -G AS_StandardAnnotation',
                '--read-filter MappingQualityNotZeroReadFilter',
            ].join(' ')
        }
        ext.prefix = { "${meta.id}.g" }
    }

    // ============================================================
    // Cohort stages 8–12
    // ============================================================

    withName: 'GATK4_COMBINEGVCFS' {
        ext.args   = '-G StandardAnnotation -G AS_StandardAnnotation'
        ext.prefix = { "${meta.id}" }
    }

    withName: 'GATK4_GENOTYPEGVCFS' {
        ext.args   = {
            [
                "--sample-ploidy ${params.sample_ploidy}",
                '-G StandardAnnotation -G AS_StandardAnnotation',
            ].join(' ')
        }
        ext.prefix = { "${meta.id}.raw_variants" }
    }

    withName: 'GATK4_SELECTVARIANTS_SNP' {
        ext.args   = '--select-type-to-include SNP --remove-unused-alternates --exclude-non-variants'
        ext.prefix = { "${meta.id}.raw_snps" }
    }

    withName: 'GATK4_SELECTVARIANTS_INDEL' {
        ext.args   = '--select-type-to-include INDEL --remove-unused-alternates --exclude-non-variants'
        ext.prefix = { "${meta.id}.raw_indels" }
    }

    withName: 'GATK4_VARIANTRECALIBRATOR_SNP' {
        // Heupink 2021 SNP recalibration:
        //   - allele-specific (-AS)
        //   - annotations: AS_MQRankSum, AS_QD, AS_MQ, DP
        //   - max-gaussians configurable (4 default; knock down for small N)
        //   - MQ-cap 60, tranches 100.0 / 99.9 / 99.0
        //   - --target-titv passed only if user supplied it (organism-specific; 1.85 for MTB)
        ext.args   = {
            [
                '-AS',
                '-an AS_MQRankSum -an AS_QD -an AS_MQ -an DP',
                '-mode SNP',
                "--max-gaussians ${params.vqsr_max_gaussians_snp}",
                '-mq-cap 60',
                '-tranche 100.0 -tranche 99.9 -tranche 99.0',
                params.target_titv ? "--target-titv ${params.target_titv}" : '',
            ].findAll { it }.join(' ')
        }
        ext.prefix = { "${meta.id}.snp" }
    }

    withName: 'GATK4_VARIANTRECALIBRATOR_INDEL' {
        // Heupink 2021 INDEL recalibration:
        //   - (no allele-specific)
        //   - annotations: MQRankSum, QD, DP
        //   - max-gaussians configurable (2 default; knock down for small N)
        //   - MQ-cap 60, tranches 100.0 / 99.9 / 99.0
        ext.args   = {
            [
                '-an MQRankSum -an QD -an DP',
                '-mode INDEL',
                "--max-gaussians ${params.vqsr_max_gaussians_indel}",
                '-mq-cap 60',
                '-tranche 100.0 -tranche 99.9 -tranche 99.0',
            ].join(' ')
        }
        ext.prefix = { "${meta.id}.indel" }
    }

    withName: 'GATK4_APPLYVQSR_SNP' {
        // Heupink 2021: SNP filter at 99.9% truth sensitivity, drop filtered records
        ext.args   = '-AS --ts-filter-level 99.9 -mode SNP --exclude-filtered'
        ext.prefix = { "${meta.id}.FilteredSNPs" }
    }

    withName: 'GATK4_APPLYVQSR_INDEL' {
        // Heupink 2021: INDEL filter at VQSLOD ≥ 0, drop filtered records
        ext.args   = { "--lod-score-cutoff ${params.indel_lod_cutoff ?: 0.0} -mode INDEL --exclude-filtered" }
        ext.prefix = { "${meta.id}.FilteredINDELs" }
    }

    // ============================================================
    // VariantFiltration — hard-filter fallback path
    //   Used when params.{snp,indel}_filter_mode == 'hard_filters'. Wraps GATK
    //   VariantFiltration with --filter-expression / --filter-name, then drops
    //   failing records via downstream selection. Defaults are GATK best-
    //   practice tuned for haploid bacterial calling (see
    //   params.{snp,indel}_hard_filter_expression).
    // ============================================================

    withName: 'GATK4_VARIANTFILTRATION_SNP' {
        ext.args = {
            [
                "--filter-expression '${params.snp_hard_filter_expression}'",
                "--filter-name '${params.snp_hard_filter_name}'",
            ].join(' ')
        }
        ext.prefix = { "${meta.id}.FilteredSNPs.hardfilter" }
    }

    withName: 'GATK4_VARIANTFILTRATION_INDEL' {
        ext.args = {
            [
                "--filter-expression '${params.indel_hard_filter_expression}'",
                "--filter-name '${params.indel_hard_filter_name}'",
            ].join(' ')
        }
        ext.prefix = { "${meta.id}.FilteredINDELs.hardfilter" }
    }
}
