/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    mycobactopia-org/xbs-variant-calling Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // ===== Input =====
    input                      = null   // samplesheet: study, sample, library, r1, r2

    // ===== Reference bundle (organism-agnostic via config) =====
    // The fasta must be co-located with its .fai, .dict, and BWA index files
    // (.amb, .ann, .bwt, .pac, .sa). The expected layout is:
    //   ${reference_dir}/${reference_basename}.fa
    //   ${reference_dir}/${reference_basename}.fa.fai
    //   ${reference_dir}/${reference_basename}.dict
    //   ${reference_dir}/${reference_basename}.fa.{amb,ann,bwt,pac,sa}
    reference_dir              = null
    reference_basename         = null   // e.g. "NC-000962-3-H37Rv" for MTB

    // ===== Cohort joint-genotyping toggle =====
    // skip_cohort=true runs only the per-sample stages (mapping → MarkDup →
    // [optional BQSR] → HaplotypeCaller) and emits the GVCFs without running
    // CombineGVCFs / GenotypeGVCFs / VQSR. Useful for (a) incremental cohorts
    // where the cohort step is re-run separately, and (b) consumers (e.g.
    // mtbc-varcaller-nf) that want only the per-sample GVCFs to feed a
    // different cohort-stage backend.
    skip_cohort                = false

    // ===== HaplotypeCaller backend selection =====
    // false (default) → run nf-core's GATK4_HAPLOTYPECALLER (non-Spark, stable)
    // true            → run local GATK4SPARK_HAPLOTYPECALLER with
    //                   --spark-master local[$task.cpus] (per-sample parallelism)
    // Both backends emit identical {vcf, tbi, vcf_tbi, versions} channels so
    // every downstream stage is agnostic to which ran. Default `false` keeps
    // the pipeline byte-equivalent to v0.3.0 unless the user opts in.
    //
    // Positively-phrased for launcher compatibility: some launchers serialise
    // `--param foo=false` as the string "false" which is truthy in Groovy;
    // that makes double-negatives like `skip_x=false` unreliable across
    // launchers. `use_x=true` avoids that entire class of surprise.
    use_spark_haplotypecaller = false

    // ===== Variant filtering — per-mode contract =====
    // Replaces the old skip_{snp,indel}_vqsr booleans with a tri-state per
    // mode so consumers can pick between VQSR, GATK hard-filters, or no
    // filtering at all. The default ('vqsr') matches Heupink 2021. MAGMA's
    // historical behaviour maps to: snp_filter_mode='vqsr',
    // indel_filter_mode='hard_filters'.
    //
    //   'vqsr'         — train VariantRecalibrator + ApplyVQSR  (default; needs truth VCF)
    //   'hard_filters' — apply GATK VariantFiltration with the *_hard_filter_expression
    //   'none'         — pass-through the SelectVariants split (no filtering)
    snp_filter_mode            = 'vqsr'
    indel_filter_mode          = 'vqsr'

    // ===== VQSR truth sets =====
    // Required only when the corresponding *_filter_mode is 'vqsr'.
    snp_truth_vcf              = null
    snp_truth_vcf_tbi          = null   // defaults to ${snp_truth_vcf}.tbi if unset
    indel_truth_vcf            = null
    indel_truth_vcf_tbi        = null   // defaults to ${indel_truth_vcf}.tbi if unset

    // VQSR fails to converge on small cohorts. Heupink 2021 used 12+ samples.
    // Knock these down for small N (e.g. 3-sample test profile).
    vqsr_max_gaussians_snp     = 4
    vqsr_max_gaussians_indel   = 2

    // ===== Hard-filter expressions (used only when *_filter_mode == 'hard_filters') =====
    // GATK best-practice expressions adapted for haploid bacterial calling.
    // Override per-organism if needed. Failing variants are marked with the
    // corresponding filter name and dropped via --exclude-filtered.
    snp_hard_filter_expression   = 'QD < 2.0 || FS > 60.0 || MQ < 40.0 || MQRankSum < -12.5 || ReadPosRankSum < -8.0 || SOR > 3.0'
    snp_hard_filter_name         = 'snp_hard_filter'
    indel_hard_filter_expression = 'QD < 2.0 || FS > 200.0 || ReadPosRankSum < -20.0 || SOR > 10.0'
    indel_hard_filter_name       = 'indel_hard_filter'

    // ===== BQSR — opt-in (paper-true default: skipped) =====
    // The Heupink 2021 paper explicitly omits BQSR to avoid contaminant variants
    // being interpreted as systematic errors. Enable only on clean / curated input.
    skip_bqsr                  = true
    dbsnp_vcf                  = null   // required if !skip_bqsr
    dbsnp_vcf_tbi              = null   // defaults to ${dbsnp_vcf}.tbi

    // ===== Organism-specific knobs =====
    sample_ploidy              = 1      // bacterial default; 2 for diploid (unsupported by XBS)
    target_titv                = null   // e.g. 1.85 for MTB; null → omit --target-titv
    indel_lod_cutoff           = 0.0    // Heupink 2021 INDEL VQSLOD cutoff
    bwa_extra_args             = ''     // hook for consumer tuning (e.g. MAGMA's "-k 100")
    joint_name                 = 'joint'  // basename for cohort-level VCFs

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test         { includeConfig 'conf/test.config'         }
    test_full    { includeConfig 'conf/test_full.config'    }
    abc_cluster  { includeConfig 'conf/abc_cluster.config'  }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load mycobactopia-org/xbs-variant-calling custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load mycobactopia-org/xbs-variant-calling custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/xbs-variant-calling.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'mycobactopia-org/xbs-variant-calling'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Abhinav Sharma',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/mycobactopia-org/xbs-variant-calling'
    description     = """compleX Bacterial Sample variant caller — Nextflow port of the XBS pipeline (Heupink 2021) as a generic-bacterial reusable variant-calling subworkflow."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '0.1.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
